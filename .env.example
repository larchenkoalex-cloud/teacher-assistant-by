# Пример .env файла
# Скопируйте в .env и добавьте ваш ключ (НЕ коммитите .env в git)

# Ключ OpenRouter (в UI используется переменная OPENROUTER_API_KEY)
OPENROUTER_API_KEY=

# База данных (для разработки можно оставить SQLite)
DATABASE_URL=sqlite:///teacher_assistant.db

# Где хранить загруженные материалы
MATERIALS_DIR=materials

# Legacy (не используется, оставлено как подсказка)
# DEEPSEEK_API_KEY=

# Для будущего масштабирования (пока не используется)
# REDIS_URL=redis://localhost:6379/0
# LOG_LEVEL=INFO
